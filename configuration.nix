# ── configuration.nix ───────────────────────────────────────────────────────
# Machine entry point (Dell Latitude 5410): hardware scan + hostname + the
# system modules in ./System. Per-user config (Home Manager) is in ./Home and
# is plugged in by System/core/home-manager.nix.
#
# `host` and `user` come from flake.nix (specialArgs).
{ host, ... }:
{
  imports = [
    # Auto-generated by `nixos-generate-config` (disks, kernel modules).
    # Do NOT hand-edit; regenerate it when you reinstall on new hardware.
    ./hardware-configuration.nix

    # Everything shared (boot, nix, hardware, apps) plus the desktop.
    ./System
  ];

  # Must match the flake's nixosConfigurations name, so that
  # `nixos-rebuild switch --flake .` picks this machine automatically.
  networking.hostName = host;

  # Keep at the version used when the system was FIRST installed. It does not
  # upgrade the system; it only keeps old stateful defaults (databases, etc.)
  # compatible. Never bump it just because a new release came out.
  system.stateVersion = "26.05";
}
