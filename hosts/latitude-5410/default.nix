# ── hosts/latitude-5410/default.nix ─────────────────────────────────────────
# Machine-specific entry point: hardware scan + hostname + shared modules.
#
# To add another computer later, copy this folder (e.g. hosts/thinkpad/),
# regenerate its hardware-configuration.nix, and add a second entry under
# nixosConfigurations in flake.nix.
{ ... }:
{
  imports = [
    # Auto-generated by `nixos-generate-config` (disks, kernel modules).
    # Do NOT hand-edit; regenerate it when you reinstall on new hardware.
    ./hardware-configuration.nix

    # Everything shared between machines (boot, nix, desktop, ...).
    ../../modules
  ];

  # Must match the flake's nixosConfigurations name.
  networking.hostName = "nixos";

  # Keep at the version used when the system was FIRST installed. It does not
  # upgrade the system; it only keeps old stateful defaults (databases, etc.)
  # compatible. Never bump it just because a new release came out.
  system.stateVersion = "26.05";
}
